# Production derlemesi (npm run deploy:prod). Kopyala: .env.production — git'e girmez.
# Değerler: Supabase → Project Settings → API (Project URL, anon/publishable key).
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# AGPL: kaynak kodun bulunduğu depo adresi (giriş sayfasındaki "Kaynak kodu" bağlantısı)
# VITE_SOURCE_URL=https://github.com/<kullanıcı>/<depo>
# İsteğe bağlı hata takibi
# VITE_SENTRY_DSN=
