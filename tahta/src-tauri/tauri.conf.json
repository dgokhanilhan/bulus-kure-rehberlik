{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BK Yoklama",
  "mainBinaryName": "bk-yoklama",
  "version": "0.2.0",
  "identifier": "tr.k12.buluskure.yoklama",
  "build": {
    "beforeBuildCommand": "npx vite build",
    "beforeDevCommand": "npx vite --port 5180 --strictPort",
    "devUrl": "http://localhost:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BK Akıllı Yoklama",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co http://127.0.0.1:54321 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Buluş Küre Koleji",
    "shortDescription": "Buluş Küre Akıllı Yoklama",
    "longDescription": "Akıllı tahtadan sabah yoklamasını alıp buluskurementor.com'a gönderir.",
    "copyright": "© 2026 Buluş Küre Koleji · AGPL-3.0",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFREEwMEY1MEEzNkQyQTgKUldTbzBqWUs5UURhRHZjbDZiY08vMFFSS1NxRVdVS0NmVW5oT2pZSVczUlQ5MnRrL0Y5VTNnOHgK",
      "endpoints": [
        "https://github.com/dgokhanilhan/bulus-kure-rehberlik/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
