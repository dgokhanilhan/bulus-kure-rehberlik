# Yerel geliştirme: `supabase status -o env` çıktısındaki değerleri .env.local dosyasına kopyala.
# Bu dosyaya gerçek anahtar YAZMA. .env.local repoya girmez.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Yalnız testler için (Vitest / Playwright). Tarayıcı koduna asla girmez; VITE_ öneki yok.
SUPABASE_SERVICE_ROLE_KEY=

# AGPL-3.0 §13: uygulamanın kaynak koduna bağlantı (giriş ekranında ve profil menüsünde gösterilir)
VITE_SOURCE_URL=

# Hata izleme (isteğe bağlı, Sentry ücretsiz plan). Boşsa kapalı. Kişisel veri gönderilmez.
VITE_SENTRY_DSN=
