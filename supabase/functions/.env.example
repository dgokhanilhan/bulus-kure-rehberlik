# Yerel Edge Function ortamı (kopyala: supabase/functions/.env). Gerçek anahtarı asla repoya yazma.
DEEPSEEK_API_KEY=yerel-sahte-anahtar
DEEPSEEK_BASE_URL=http://host.docker.internal:54399
# DEEPSEEK_MODEL=deepseek-flash
# Yalnız yerel: davet bağlantısının yönlendirebileceği ek adresler (yalnız localhost/127.0.0.1 kabul edilir). Canlıda TANIMLAMA.
DAVET_YEREL_ADRESLER=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
