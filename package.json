{
  "name": "bulus-kure-rehberlik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/prepare-program-ocr.mjs && vite",
    "build": "node scripts/prepare-program-ocr.mjs && npm run tokens && tsc -b && vite build",
    "preview": "vite preview",
    "katalog:meb": "node scripts/meb-katalog/olustur.mjs",
    "typecheck": "tsc -b --noEmit",
    "tokens": "node scripts/gen-tokens.mjs",
    "seed:gen": "node scripts/gen-seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:reset": "supabase db reset",
    "regresyon:kaydet": "REGRESYON_KAYDET=1 vitest run tests/regresyon.test.ts",
    "ornek:gen": "node scripts/gen-ornek-paket.mjs",
    "katalog:gen": "node scripts/gen-outcomes.mjs",
    "ai:sahte": "node scripts/sahte-deepseek.mjs",
    "functions": "supabase functions serve",
    "e2e:dist": "npm run build && E2E_DIST=1 playwright test e2e/asama3.spec.ts e2e/asama4.spec.ts e2e/dosyalar.spec.ts e2e/davet.spec.ts e2e/acilis.spec.ts",
    "deploy:staging": "node scripts/prepare-program-ocr.mjs && npm run tokens && tsc -b && vite build --mode staging && npx wrangler pages deploy dist --project-name bulus-kure-staging --branch master",
    "deploy:prod": "node scripts/prepare-program-ocr.mjs && npm run tokens && tsc -b && vite build --mode production && npx wrangler pages deploy dist --project-name ${CF_PROJECT:-bulus-kure} --branch main",
    "mobil:build": "node scripts/prepare-program-ocr.mjs && npm run tokens && tsc -b && vite build --mode mobil && cap sync",
    "mobil:ios": "npm run mobil:build && cap open ios",
    "mobil:android": "npm run mobil:build && cap open android",
    "e2e:mobil": "vite build --mode mobil && E2E_MOBIL=1 playwright test e2e/mobil.spec.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/react": "^11.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "exceljs": "4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^5.8.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tur": "^1.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "otplib": "^13.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
